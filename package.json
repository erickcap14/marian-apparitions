{
  "name": "marian-apparitions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && VITE_PUBLIC_BUILD=true vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:public": "VITE_PUBLIC_BUILD=true vite preview",
    "server": "tsx --env-file=.env server/index.ts",
    "server:dev": "NODE_ENV=development tsx watch --env-file=.env server/index.ts",
    "start:lan": "npm run build && npm run server",
    "generate-summaries": "npx tsx scripts/generate-summaries.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "maplibre-gl": "^4.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "selfsigned": "^5.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.3.4",
    "vitest": "^4.1.8"
  }
}
