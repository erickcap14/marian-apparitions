# ── Server-side secrets (NEVER exposed to the browser) ──────────────────────
# These are read by the Node backend (server/index.ts) only. No VITE_ prefix,
# so Vite will not bundle them into the client.

# Anthropic API key for AI summary / analytics generation.
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Shared password everyone on your LAN must enter to access the app.
# Choose something strong; rotate it if someone should lose access.
APP_PASSWORD=change-me-to-a-strong-passphrase

# Secret used to sign session cookies. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional: HTTPS port the LAN server binds to (default 8443).
# PORT=8443
